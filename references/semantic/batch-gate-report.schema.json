{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V14 executable semantic batch gate report with V9-shaped renderer compatibility",
  "type": "object",
  "required": ["schema", "package_id", "created_at", "batch_id", "decision", "bindings", "metrics", "failures", "plans"],
  "properties": {
    "schema": {"const": "semantic-batch-gate-report/v260928"},
    "package_id": {"const": "video-montage"},
    "created_at": {"type": "string"},
    "batch_id": {"type": ["string", "null"]},
    "decision": {"enum": ["pass", "reject"]},
    "bindings": {"type": "object"},
    "metrics": {"type": "object"},
    "failures": {"type": "array", "items": {"type": "object", "required": ["code", "scope", "detail"], "properties": {"code": {"type": "string"}, "scope": {"type": "string"}, "detail": {"type": "string"}}}},
    "plans": {"type": "array", "items": {"type": "object", "required": ["plan_id", "plan_revision", "duration", "ordered_plan_signature", "semantic_route_signature", "segments", "transitions"], "properties": {"plan_id": {"type": "string"}, "plan_revision": {"type": "integer"}, "duration": {"type": "number"}, "ordered_plan_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "semantic_route_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "segments": {"type": "array"}, "transitions": {"type": "array"}}}}
  }
}
