{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V14 gate runtime input schema collection with V9-shaped render artifacts",
  "$defs": {
    "work_order": {"type": "object", "required": ["schema", "package_id", "package_skill_sha256", "batch_id", "requested_outputs", "style_contract", "policy"], "properties": {"schema": {"const": "semantic-video-work-order/v260928"}, "package_id": {"const": "video-montage"}, "package_skill_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "batch_id": {"type": "string"}, "requested_outputs": {"type": "integer", "minimum": 1}, "style_contract": {"type": "object"}, "policy": {"type": "object", "required": ["content_grounding_contract"]}}},
    "candidate_inventory": {"type": "object", "required": ["schema", "batch_id", "work_order_sha256", "status", "sources", "candidates"], "properties": {"schema": {"const": "semantic-candidate-inventory/v260928"}, "status": {"enum": ["incomplete", "witness_sufficient", "exhausted"]}, "sources": {"type": "array"}, "candidates": {"type": "array"}}},
    "lock_request": {"type": "object", "required": ["schema", "package_id", "batch_id", "analysis_snapshot_id", "analysis_record_path", "analysis_record_sha256", "work_order_path", "work_order_sha256", "candidate_inventory_path", "candidate_inventory_sha256", "unique_plan_witness_path", "unique_plan_witness_sha256", "plans"], "properties": {"schema": {"const": "semantic-batch-lock-request/v260928"}, "package_id": {"const": "video-montage"}, "plans": {"type": "array"}}},
    "output_qc": {"type": "object", "required": ["schema", "decision", "locked_index_sha256", "outputs"], "properties": {"schema": {"const": "semantic-output-qc-report/v260928"}, "decision": {"enum": ["pass", "reject"]}, "locked_index_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "outputs": {"type": "array"}}},
    "orchestrator_state": {"type": "object", "required": ["schema", "task_id", "config_path", "config_sha256", "phase_index", "current_phase", "repair_round", "status", "revision", "artifacts", "history"], "properties": {"schema": {"const": "semantic-production-orchestrator-state/v260928"}, "status": {"enum": ["READY", "CHUNK_PENDING", "WAITING_MODEL", "COMPLETE", "FAILED"]}}},
    "model_phase_response": {"type": "object", "required": ["schema", "task_id", "phase", "decision", "outputs"], "properties": {"schema": {"const": "semantic-model-phase-response/v260928"}, "decision": {"enum": ["pass", "repair_required", "reject"]}, "outputs": {"type": "array"}}}
  }
}
